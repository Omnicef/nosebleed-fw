# SPDX-License-Identifier: GPL-3.0-only
#
# ESP-IDF build options — currently INERT on the Arduino framework (see
# SPIKE_RESULTS.md T-0.6). Arduino-ESP32 ships a fixed, prebuilt sdkconfig.h
# per (chip, memory_type); pioarduino's prebuild hook overwrites anything a
# user file might set. These settings become live at the T-9.3 Arduino-as-
# IDF-component conversion.
#
# Kept here anyway so the intent survives until then. `src/main.cpp` logs
# the CONFIG_* values it actually built against on every boot, so drift
# between this file and reality is visible without opening sdkconfig.h.

# --- PSRAM: octal, board variant already sets qio_opi — this is a live setting.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_BOOT_INIT=y

# --- mbedTLS (T-0.6: ~14 KB recovery deferred to T-9.3). ---------------------
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# --- Data cache. Arduino prebuilts all ship 32 KB; 64 KB waits for T-9.3. ---
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# --- FreeRTOS tick: already 1 kHz on Arduino default. ------------------------
CONFIG_FREERTOS_HZ=1000

# --- Brownout detector (used by T-11.1 watchdogs). ---------------------------
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_4=y
